# ==============================================================================
# MAVRA Environment Configuration
# Copy to `.env` before running database-backed commands or live LLM agents.
# Offline unit tests (`cargo test --locked`), experiment index checks, and figure
# regeneration (`make figures`) do not require a database or API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Connections
# Required for `mavra serve`, `maint-bench`, `replay-bench`, `binding-bench`,
# `metric-bench`, `workload-bench`, and data loaders (`AGENTDB_URL` is also
# accepted as a backward-compatible alias).
# ------------------------------------------------------------------------------
MAVRA_DB_URL=postgres://postgres:postgres@127.0.0.1:5432/mavra

# Optional: administration URL for isolated PostgreSQL integration tests and Q5
# scalability/concurrency benchmarks (`make db-test` / `q5_bench_tests`).
# The role needs CREATEDB (not SUPERUSER); each test creates and drops its own
# temporary database (`AGENTDB_TEST_URL` is also accepted as an alias).
MAVRA_TEST_DB_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# ------------------------------------------------------------------------------
# 2. Optional Neural Semantic Lookup Service (`tools/lookup/service.py`)
# When set, `find_metric` routes requests through dense `BAAI/bge-m3` retrieval
# and 3-model `XLM-RoBERTa` peer-difference cross-encoders (`Hit/Diffs/Refer/Miss`).
# When unset, MAVRA falls back to deterministic local name/alias lookup.
# ------------------------------------------------------------------------------
MAVRA_LOOKUP_URL=

# ------------------------------------------------------------------------------
# 3. Optional LLM Provider Profiles
# Required ONLY for live agent/extraction workloads (`metric-bench`,
# `workload-bench`, `mavra serve --extractor <profile>`, and RelBench exploration).
# Deterministic benchmarks (`maint-bench`, `replay-bench`, `binding-bench`,
# `q5_bench_tests`) make zero LLM calls and do not read these variables.
# ------------------------------------------------------------------------------

# Profile `openai`: OpenAI or any standard OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_REASONING_EFFORT=
OPENAI_THINKING=

# Profile `deepseek`: Official DeepSeek API (default base URL: https://api.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_THINKING=enabled

# Profile `zhipu`: Official Zhipu BigModel API (default base URL: https://open.bigmodel.cn/api/paas/v4)
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.5-air
ZHIPU_REASONING_EFFORT=
ZHIPU_THINKING=enabled

# Profile `anthropic`: Official Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
